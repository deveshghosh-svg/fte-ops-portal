<script>
  // ── WAREHOUSE COORDINATES & GEOFENCE LIMIT ──
  var WAREHOUSE_LAT = 28.2729; // ⚠️ Replace with your actual Warehouse Latitude
  var WAREHOUSE_LNG = 76.8712; // ⚠️ Replace with your actual Warehouse Longitude
  var MAX_ALLOWED_KM = 1.0;    // 1 km limit

  var capturedLat = null, capturedLng = null, locationReady = false;
  var pendingTodayStatus = '', pendingExistingStatus = '';
  var isManagerUser = false;
  var matchedManagerEmail = '';
  var pendingDecision = null;
  var sessionApproved = 0, sessionRejected = 0;

  // ── PWA / Shortcut Banner Logic ──
  function checkPwaBanner() {
    // Check if the user is ALREADY inside the standalone/shortcut window
    var isStandalone = window.matchMedia('(display-mode: standalone)').matches || 
                       window.navigator.standalone || 
                       document.referrer.includes('android-app://');
    
    // Show banner on mobile browsers whenever accessed outside the created shortcut
    if (!isStandalone && (navigator.userAgent.match(/Android/i) || navigator.userAgent.match(/iPhone|iPad|iPod/i))) {
      document.getElementById('pwaBanner').style.display = 'flex';
    } else {
      document.getElementById('pwaBanner').style.display = 'none';
    }
  }

  function dismissPwaBanner() {
    // Hides for current tab session only
    document.getElementById('pwaBanner').style.display = 'none';
  }

  function showPwaInstructions() {
    var isiOS = /iPhone|iPad|iPod/i.test(navigator.userAgent);
    if (isiOS) {
      alert("To Create Shortcut on iPhone:\n\n1. Tap the Share icon (at bottom of Safari)\n2. Scroll down & select 'Add to Home Screen'\n3. Tap 'Add' in top right");
    } else {
      alert("To Create Shortcut on Android:\n\n1. Tap the browser menu (3 dots at top right)\n2. Tap 'Add to Home screen' or 'Create shortcut'\n3. Tap 'Add' or 'Install'");
    }
  }

  checkPwaBanner();
  
  // Haversine distance calculator in KM
  function calculateDistanceKm(lat1, lon1, lat2, lon2) {
    var R = 6371;
    var dLat = (lat2 - lat1) * Math.PI / 180;
    var dLon = (lon2 - lon1) * Math.PI / 180;
    var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
            Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
            Math.sin(dLon / 2) * Math.sin(dLon / 2);
    var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    return R * c;
  }

  function isWarehouseStatusRequired(status) {
    var reqStatuses = ['P', 'NP', 'HP', 'HNP'];
    return reqStatuses.indexOf(String(status).trim().toUpperCase()) !== -1;
  }

  function checkGeofenceValid(status) {
    if (!isWarehouseStatusRequired(status)) return { valid: true };
    if (!capturedLat || !capturedLng) return { valid: false, message: 'Location coordinates not captured.' };

    var distKm = calculateDistanceKm(capturedLat, capturedLng, WAREHOUSE_LAT, WAREHOUSE_LNG);
    if (distKm > MAX_ALLOWED_KM) {
      var distMeters = Math.round(distKm * 1000);
      var formattedDist = distKm < 1 ? (distMeters + 'm') : (distKm.toFixed(2) + 'km');
      return {
        valid: false,
        message: 'Status "' + status + '" requires presence at office. You are ' + formattedDist + ' away from office.'
      };
    }
    return { valid: true };
  }

  // ── Dark Mode Handling ──
  function applySavedTheme() {
    var isDark = localStorage.getItem('ops_theme') === 'dark';
    if (isDark) {
      document.body.classList.add('dark-theme');
      document.getElementById('themeIcon').textContent = '☀️';
      document.getElementById('themeLabel').textContent = 'Light';
    } else {
      document.body.classList.remove('dark-theme');
      document.getElementById('themeIcon').textContent = '🌙';
      document.getElementById('themeLabel').textContent = 'Dark';
    }
  }

  function toggleTheme() {
    var isDark = document.body.classList.toggle('dark-theme');
    localStorage.setItem('ops_theme', isDark ? 'dark' : 'light');
    document.getElementById('themeIcon').textContent = isDark ? '☀️' : '🌙';
    document.getElementById('themeLabel').textContent = isDark ? 'Light' : 'Dark';
  }

  applySavedTheme();

  function formatDateToISO(d) {
    var year = d.getFullYear();
    var month = String(d.getMonth() + 1).padStart(2, '0');
    var day = String(d.getDate()).padStart(2, '0');
    return year + '-' + month + '-' + day;
  }

  // 5:00 AM Night shift rollover
  var now = new Date();
  var workingDate = new Date(now);

  if (now.getHours() < 5) {
    workingDate.setDate(workingDate.getDate() - 1);
  }

  var todayISO = formatDateToISO(workingDate);

  document.getElementById('todayLabel').textContent = workingDate.toLocaleDateString('en-IN', {
    weekday: 'short', day: 'numeric', month: 'short', year: 'numeric'
  });

  // Calculate Date Limits
  var min7DaysObj = new Date(workingDate);
  min7DaysObj.setDate(min7DaysObj.getDate() - 7);
  var min7DaysISO = formatDateToISO(min7DaysObj);

  var yesterdayObj = new Date(workingDate);
  yesterdayObj.setDate(yesterdayObj.getDate() - 1);
  var maxBackdateISO = formatDateToISO(yesterdayObj);

  var backdateInput = document.getElementById('backdateDate');
  backdateInput.min = min7DaysISO;
  backdateInput.max = maxBackdateISO;

  var correctionInput = document.getElementById('correctionDate');
  correctionInput.min = min7DaysISO;
  correctionInput.max = todayISO;

  backdateInput.addEventListener('change', function() {
    if (this.value > maxBackdateISO) {
      alert("Future dates or today's date are not allowed for backdate entries.");
      this.value = maxBackdateISO;
    } else if (this.value < min7DaysISO) {
      alert("Dates older than 7 days are not allowed.");
      this.value = min7DaysISO;
    }
    checkBackdate();
  });

  correctionInput.addEventListener('change', function() {
    if (this.value > todayISO) {
      alert("Future dates cannot be selected.");
      this.value = todayISO;
    } else if (this.value < min7DaysISO) {
      alert("Correction is allowed only for the last 7 days.");
      this.value = min7DaysISO;
    }
  });

  // Fetch User and Check Manager Access
  google.script.run
    .withSuccessHandler(function(res) {
      document.getElementById('emailDisplay').textContent = res.email || 'Unable to fetch';
      isManagerUser = res.isManager;
      matchedManagerEmail = res.email || '';

      var tabBtn = document.getElementById('tabManager');
      if (isManagerUser) {
        if (res.pendingCount > 0) {
          tabBtn.innerHTML = '🔴 Manager (' + res.pendingCount + ')';
          tabBtn.style.color = '#c2410c';
        } else {
          tabBtn.innerHTML = '✅ Manager';
          tabBtn.style.color = '#15803d';
        }
      }
    })
    .withFailureHandler(function() {
      document.getElementById('emailDisplay').textContent = 'Error fetching email';
    })
    .checkIsManager();

  // Location Detection with 300m Threshold
  function detectLocation() {
    if (!navigator.geolocation) { setLocFail('Geolocation not supported.'); return; }
    navigator.geolocation.getCurrentPosition(
      function(pos) {
        capturedLat = pos.coords.latitude; 
        capturedLng = pos.coords.longitude; 
        locationReady = true;
        
        var distKm = calculateDistanceKm(capturedLat, capturedLng, WAREHOUSE_LAT, WAREHOUSE_LNG);
        var distMeters = Math.round(distKm * 1000);
        
        var distText = '';
        if (distMeters <= 300) {
          distText = 'At office';
        } else if (distMeters < 1000) {
          distText = distMeters + 'm away from office';
        } else {
          distText = distKm.toFixed(2) + 'km away from office';
        }

        document.getElementById('locBlock').className = 'loc-block ok';
        document.getElementById('locText').innerHTML = 'Location Captured (' + distText + ' — <a href="https://maps.google.com/?q='+capturedLat+','+capturedLng+'" target="_blank">Map</a>)';
        document.getElementById('locWall').style.display = 'none';
        checkTodayReady();
      },
      function(err) {
        var m = 'Location denied.';
        if(err.code===1) m='Permission denied.';
        if(err.code===2) m='Location unavailable.';
        if(err.code===3) m='Timed out. Reload.';
        setLocFail(m);
      },
      { timeout:15000, enableHighAccuracy:true }
    );
  }
  
  function setLocFail(msg) {
    document.getElementById('locBlock').className='loc-block fail';
    document.getElementById('locText').textContent=msg;
    document.getElementById('locWall').style.display='block';
    document.getElementById('btnToday').disabled=true;
    locationReady=false;
  }

  // Switch Tab
  function switchTab(tab) {
    ['today','backdate','correction','manager'].forEach(function(t){
      document.getElementById('panel-'+t).classList.toggle('active', t===tab);
      document.querySelectorAll('.tab-btn')[['today','backdate','correction','manager'].indexOf(t)].classList.toggle('active', t===tab);
    });

    if (tab === 'manager') {
      if (!isManagerUser) {
        document.getElementById('managerRestricted').style.display = 'block';
        document.getElementById('managerContent').style.display = 'none';
      } else {
        document.getElementById('managerRestricted').style.display = 'none';
        document.getElementById('managerContent').style.display = 'block';
        loadPendingRequests();
      }
    }
  }

  function checkTodayReady() {
    var picked = !!document.querySelector('input[name="statusToday"]:checked');
    document.getElementById('btnToday').disabled = !(locationReady && picked);
  }
  document.querySelectorAll('input[name="statusToday"]').forEach(function(r){ r.addEventListener('change', checkTodayReady); });

  function checkBackdate() {
    var date   = document.getElementById('backdateDate').value;
    var picked = !!document.querySelector('input[name="statusBack"]:checked');
    var rem    = document.getElementById('backdateRemarks').value.trim();
    document.getElementById('btnBack').disabled = !(locationReady && date && picked && rem);
  }
  document.querySelectorAll('input[name="statusBack"]').forEach(function(r){ r.addEventListener('change', checkBackdate); });
  document.getElementById('backdateRemarks').addEventListener('input', checkBackdate);
  document.getElementById('backdateDate').addEventListener('change', checkBackdate);

  function closeDlg(id) { document.getElementById(id).classList.remove('open'); }
  function openDlg(id)  { document.getElementById(id).classList.add('open'); }
  document.querySelectorAll('.dialog-overlay').forEach(function(el){
    el.addEventListener('click', function(e){ if(e.target===this) this.classList.remove('open'); });
  });

  // Employee Submissions
  function openTodayDialog() {
    if (!locationReady) { showResult('resultToday', false, 'Location required.'); return; }
    var s = document.querySelector('input[name="statusToday"]:checked');
    if (!s) { showResult('resultToday', false, 'Select status.'); return; }
    
    var geo = checkGeofenceValid(s.value);
    if (!geo.valid) {
      showResult('resultToday', false, geo.message);
      return;
    }

    pendingTodayStatus = s.value;
    document.getElementById('dlgTodayStatus').textContent = s.value;
    openDlg('dlgToday');
  }

  function confirmToday() {
    closeDlg('dlgToday');
    var btn = document.getElementById('btnToday');
    btn.disabled = true; btn.textContent = 'Submitting...';
    
    google.script.run
      .withSuccessHandler(function(res) {
        btn.textContent = 'Mark Attendance';
        if (res.message === 'already_marked') {
          pendingExistingStatus = res.existing;
          document.getElementById('dlgExistingStatus').textContent = res.existing;
          document.getElementById('dlgCorrRemarks').value = '';
          openDlg('dlgAlreadyMarked');
          btn.disabled = false;
        } else {
          showResult('resultToday', res.success, res.message);
          if (!res.success) btn.disabled = false;
          else loadMonthlyCalendar();
        }
      })
      .withFailureHandler(function(err) {
        btn.disabled = false; btn.textContent = 'Mark Attendance';
        showResult('resultToday', false, 'Failed: ' + err.message);
      })
      .submitAttendanceFromWebApp(pendingTodayStatus, capturedLat, capturedLng, todayISO);
  }

  function sendCorrectionFromDialog() {
    var remarks = document.getElementById('dlgCorrRemarks').value.trim();
    if (!remarks) { alert('Remarks are mandatory.'); return; }
    var newStatus = pendingTodayStatus;

    var geo = checkGeofenceValid(newStatus);
    if (!geo.valid) {
      closeDlg('dlgAlreadyMarked');
      showResult('resultToday', false, geo.message);
      return;
    }

    closeDlg('dlgAlreadyMarked');
    google.script.run
      .withSuccessHandler(function(res){ 
        showResult('resultToday', res.success, res.message); 
        if(res.success) loadMonthlyCalendar();
      })
      .withFailureHandler(function(err){ showResult('resultToday', false, 'Failed: ' + err.message); })
      .submitApprovalRequest('correction', todayISO, newStatus, pendingExistingStatus, remarks, capturedLat, capturedLng);
  }

  function openBackdateDialog() {
    if (!locationReady) { showResult('resultBack', false, 'Location required.'); return; }
    var date   = document.getElementById('backdateDate').value;
    var status = document.querySelector('input[name="statusBack"]:checked');
    var rem    = document.getElementById('backdateRemarks').value.trim();
    if (!date || !status || !rem) { showResult('resultBack', false, 'Fill all fields.'); return; }
    
    var geo = checkGeofenceValid(status.value);
    if (!geo.valid) {
      showResult('resultBack', false, geo.message);
      return;
    }

    document.getElementById('dlgBackStatus').textContent = status.value;
    document.getElementById('dlgBackDate').textContent   = date;
    openDlg('dlgBackdate');
  }

  function confirmBackdate() {
    closeDlg('dlgBackdate');
    var date   = document.getElementById('backdateDate').value;
    var status = document.querySelector('input[name="statusBack"]:checked').value;
    var rem    = document.getElementById('backdateRemarks').value.trim();
    var btn    = document.getElementById('btnBack');
    btn.disabled = true; btn.textContent = 'Sending...';
    
    google.script.run
      .withSuccessHandler(function(res){
        btn.textContent = 'Send Request to Manager';
        showResult('resultBack', res.success, res.message);
        if (!res.success) btn.disabled = false;
        else loadMonthlyCalendar();
      })
      .withFailureHandler(function(err){
        btn.disabled = false; btn.textContent = 'Send Request to Manager';
        showResult('resultBack', false, 'Failed: ' + err.message);
      })
      .submitApprovalRequest('backdate', date, status, '', rem, capturedLat, capturedLng);
  }

  function openCorrectionDialog() {
    if (!locationReady) { showResult('resultCorr', false, 'Location required.'); return; }
    var date   = document.getElementById('correctionDate').value;
    var status = document.querySelector('input[name="statusCorr"]:checked');
    var rem    = document.getElementById('correctionRemarks').value.trim();
    if (!date)   { showResult('resultCorr', false, 'Select a date.'); return; }
    if (!status) { showResult('resultCorr', false, 'Select correct status.'); return; }
    if (!rem)    { showResult('resultCorr', false, 'Remarks are mandatory.'); return; }
    
    var geo = checkGeofenceValid(status.value);
    if (!geo.valid) {
      showResult('resultCorr', false, geo.message);
      return;
    }

    document.getElementById('dlgCorrStatus').textContent = status.value;
    document.getElementById('dlgCorrDate').textContent   = date;
    openDlg('dlgCorrection');
  }

  function confirmCorrection() {
    closeDlg('dlgCorrection');
    var date   = document.getElementById('correctionDate').value;
    var status = document.querySelector('input[name="statusCorr"]:checked').value;
    var rem    = document.getElementById('correctionRemarks').value.trim();
    var btn    = document.getElementById('btnCorr');
    btn.disabled = true; btn.textContent = 'Sending...';
    
    google.script.run
      .withSuccessHandler(function(res){
        btn.textContent = 'Send Correction Request';
        showResult('resultCorr', res.success, res.message);
        if (!res.success) btn.disabled = false;
        else loadMonthlyCalendar();
      })
      .withFailureHandler(function(err){
        btn.disabled = false; btn.textContent = 'Send Correction Request';
        showResult('resultCorr', false, 'Failed: ' + err.message);
      })
      .submitApprovalRequest('correction', date, status, '', rem, capturedLat, capturedLng);
  }

  // Accordion Toggle
  function toggleCalendarAccordion() {
    var body = document.getElementById('calendarAccordionBody');
    var arrow = document.getElementById('accordionArrow');
    var isHidden = body.classList.toggle('hidden');
    arrow.classList.toggle('collapsed', isHidden);
  }

  // Monthly Calendar Rendering Functions
  function loadMonthlyCalendar() {
    document.getElementById('calendarGrid').innerHTML = 
      '<div class="loading-wrap" style="grid-column: span 7;"><div class="spinner"></div><div style="font-size:0.75rem; color:var(--text-secondary);">Loading calendar...</div></div>';

    google.script.run
      .withSuccessHandler(renderCalendar)
      .withFailureHandler(function() {
        document.getElementById('calendarGrid').innerHTML = '<div style="grid-column:span 7; font-size:0.75rem; color:#b91c1c; text-align:center;">Failed to load calendar data.</div>';
      })
      .getMyMonthlyAttendance();
  }

  function renderCalendar(res) {
    if (!res.success) {
      document.getElementById('calendarGrid').innerHTML = '<div style="grid-column:span 7; font-size:0.75rem; color:var(--text-secondary); text-align:center;">'+res.message+'</div>';
      document.getElementById('monthSummaryWrap').style.display = 'none';
      return;
    }

    document.getElementById('calMonthTitle').textContent = 'My Attendance — ' + res.monthName;
    var grid = document.getElementById('calendarGrid');
    grid.innerHTML = '';

    var dayHeaders = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    dayHeaders.forEach(function(h) {
      grid.innerHTML += '<div class="cal-day-head">' + h + '</div>';
    });

    var now = new Date();
    if (now.getHours() < 5) now.setDate(now.getDate() - 1);

    var year = now.getFullYear();
    var month = now.getMonth();

    var firstDayIndex = new Date(year, month, 1).getDay();
    var totalDays = new Date(year, month + 1, 0).getDate();

    // Blank leading slots
    for (var i = 0; i < firstDayIndex; i++) {
      grid.innerHTML += '<div class="cal-cell" style="opacity:0; border:none; background:transparent;"></div>';
    }

    // Days grid
    for (var day = 1; day <= totalDays; day++) {
      var dayStr = String(day).padStart(2, '0');
      var monthStr = String(month + 1).padStart(2, '0');
      var isoDate = year + '-' + monthStr + '-' + dayStr;

      var status = res.records[isoDate] || '';
      
      var cleanStatusClass = status.replace(/[^a-zA-Z0-9]/g, '');
      var colorClass = status ? ('status-' + cleanStatusClass) : '';

      grid.innerHTML += 
        '<div class="cal-cell ' + colorClass + '">' +
          '<span class="cal-date-num">' + day + '</span>' +
          '<span class="cal-status-code">' + status + '</span>' +
        '</div>';
    }

    // Render Monthly Summary Counter Widget
    if (res.counts) {
      var chipsGrid = document.getElementById('summaryChipsGrid');
      var codes = ['P', 'NP', 'W/O', 'HP', 'HNP', 'L', 'OD', 'OH', 'H', 'A'];
      var chipsHtml = '';

      codes.forEach(function(code) {
        var count = res.counts[code] || 0;
        var cleanCodeClass = code.replace(/[^a-zA-Z0-9]/g, '');
        chipsHtml += 
          '<div class="sum-chip status-' + cleanCodeClass + '">' +
            '<span class="sum-chip-num">' + count + '</span>' +
            '<span class="sum-chip-code">' + code + '</span>' +
          '</div>';
      });

      chipsGrid.innerHTML = chipsHtml;
      document.getElementById('monthSummaryWrap').style.display = 'block';
    }
  }

  // Manager Dashboard Logic
  function loadPendingRequests() {
    document.getElementById('requestsContainer').innerHTML = 
      '<div class="loading-wrap"><div class="spinner"></div><div style="font-size:0.75rem; color:var(--text-secondary);">Loading team requests...</div></div>';

    google.script.run
      .withSuccessHandler(renderRequests)
      .withFailureHandler(function(err) {
        document.getElementById('requestsContainer').innerHTML =
          '<div class="empty-state"><div class="empty-icon">⚠️</div><div class="empty-title">Error Loading</div><div class="empty-sub">'+err.message+'</div></div>';
      })
      .getPendingRequests(matchedManagerEmail);
  }

  function renderRequests(list) {
    var tabBtn = document.getElementById('tabManager');

    if (!list || list.length === 0) {
      document.getElementById('sumPending').textContent = '0';
      document.getElementById('sumApproved').textContent = sessionApproved;
      document.getElementById('sumRejected').textContent = sessionRejected;
      tabBtn.innerHTML = '✅ Manager';
      tabBtn.style.color = '#15803d';

      document.getElementById('requestsContainer').innerHTML =
        '<div class="empty-state"><div class="empty-icon">🎉</div><div class="empty-title">All caught up!</div><div class="empty-sub">No pending requests to review.</div></div>';
      return;
    }

    tabBtn.innerHTML = '🔴 Manager (' + list.length + ')';
    tabBtn.style.color = '#c2410c';

    document.getElementById('sumPending').textContent  = list.length;
    document.getElementById('sumApproved').textContent = sessionApproved;
    document.getElementById('sumRejected').textContent = sessionRejected;

    var html = '';
    list.forEach(function(req) {
      var isBack = req.type === 'backdate';
      var typeLabel = isBack ? 'Backdate' : 'Correction';
      var typeCls   = isBack ? 'type-backdate' : 'type-correction';

      html +=
        '<div class="req-card" id="card-' + req.reqId + '">' +
          '<div class="req-card-top">' +
            '<div class="req-row1">' +
              '<div>' +
                '<div class="emp-name">' + req.empName + '</div>' +
                '<div class="emp-email">' + req.empEmail + '</div>' +
              '</div>' +
              '<span class="type-badge ' + typeCls + '">' + typeLabel + '</span>' +
            '</div>' +
            '<div class="meta-row">' +
              '<div class="meta-pill"><div class="meta-pill-label">Date</div><div class="meta-pill-val">' + req.targetDate + '</div></div>' +
              '<div class="meta-pill"><div class="meta-pill-label">Requested</div><div class="meta-pill-val status-val">' + req.requestedStatus + '</div></div>' +
              (req.currentStatus ? '<div class="meta-pill"><div class="meta-pill-label">Current</div><div class="meta-pill-val">' + req.currentStatus + '</div></div>' : '') +
            '</div>' +
          '</div>' +
          '<div class="emp-remarks-wrap">' +
            '<span class="remarks-label">Employee Remarks</span>' +
            '<div class="remarks-text">' + req.remarks + '</div>' +
          '</div>' +
          '<div class="mgr-input-wrap">' +
            '<textarea class="mgr-remarks-box" id="rem-' + req.reqId + '" placeholder="Optional note for employee..."></textarea>' +
            '<div class="action-btns">' +
              '<button class="btn-reject" id="rej-' + req.reqId + '" onclick="openSheet(\'' + req.reqId + '\',' + req.rowIndex + ',\'Rejected\')">✕ Reject</button>' +
              '<button class="btn-approve" id="app-' + req.reqId + '" onclick="openSheet(\'' + req.reqId + '\',' + req.rowIndex + ',\'Approved\')">✓ Approve</button>' +
            '</div>' +
          '</div>' +
          '<div class="result" id="res-' + req.reqId + '"></div>' +
        '</div>';
    });

    document.getElementById('requestsContainer').innerHTML = html;
  }

  function openSheet(reqId, rowIndex, decision) {
    pendingDecision = { reqId: reqId, rowIndex: rowIndex, decision: decision };
    var isApprove = decision === 'Approved';

    document.getElementById('sheetIcon').textContent   = isApprove ? '✅' : '❌';
    document.getElementById('sheetTitle').textContent  = isApprove ? 'Confirm Approval' : 'Confirm Rejection';
    document.getElementById('sheetBody').innerHTML     = isApprove 
      ? 'Approve this request? Attendance will be updated.' 
      : 'Reject this request? No changes will be made.';

    var btn = document.getElementById('sheetConfirmBtn');
    btn.textContent      = isApprove ? 'Approve' : 'Reject';
    btn.style.background = isApprove ? 'linear-gradient(135deg,#16a34a,#15803d)' : '#dc2626';

    openDlg('sheetOverlay');
  }

  function closeSheet() {
    closeDlg('sheetOverlay');
    pendingDecision = null;
  }

  function executeDecision() {
    if (!pendingDecision) return;
    var d = pendingDecision;
    var remEl = document.getElementById('rem-' + d.reqId);
    var mgrRem = remEl ? remEl.value.trim() : '';
    closeSheet();

    var appBtn = document.getElementById('app-' + d.reqId);
    var rejBtn = document.getElementById('rej-' + d.reqId);
    var card   = document.getElementById('card-' + d.reqId);

    if (appBtn) { appBtn.disabled = true; appBtn.textContent = '...'; }
    if (rejBtn) rejBtn.disabled = true;

    if (card) {
      card.classList.add('removing');
      setTimeout(function() {
        if (card && card.parentNode) {
          card.parentNode.removeChild(card);
        }
        
        if (d.decision === 'Approved') sessionApproved++;
        else sessionRejected++;

        var remainingCards = document.querySelectorAll('#requestsContainer .req-card:not(.removing)');
        var count = remainingCards.length;

        document.getElementById('sumPending').textContent  = count;
        document.getElementById('sumApproved').textContent = sessionApproved;
        document.getElementById('sumRejected').textContent = sessionRejected;

        var tabBtn = document.getElementById('tabManager');
        if (count > 0) {
          tabBtn.innerHTML = '🔴 Manager (' + count + ')';
          tabBtn.style.color = '#c2410c';
        } else {
          tabBtn.innerHTML = '✅ Manager';
          tabBtn.style.color = '#15803d';
          document.getElementById('requestsContainer').innerHTML =
            '<div class="empty-state"><div class="empty-icon">🎉</div><div class="empty-title">All caught up!</div><div class="empty-sub">No pending requests to review.</div></div>';
        }
      }, 350);
    }

    google.script.run
      .withFailureHandler(function(err) {
        alert('Server Sync Error: ' + err.message + '. Refreshing page...');
        loadPendingRequests();
      })
      .decideRequest(d.rowIndex, d.reqId, d.decision, mgrRem);
  }

  function showResult(id, success, msg) {
    var el = document.getElementById(id);
    el.className = 'result ' + (success ? 'ok' : 'err');
    el.textContent = (success ? '✅ ' : '❌ ') + msg;
    el.style.display = 'block';
    el.scrollIntoView({ behavior:'smooth', block:'nearest' });
  }

  // Initial Load Trigger
  detectLocation();
  loadMonthlyCalendar();
</script>
</body>
